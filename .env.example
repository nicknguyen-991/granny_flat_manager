# Copy this file to .env and fill in your PostgreSQL password.
# Never commit .env to git (it is in .gitignore).
#
# Note: project folder is granny_flat_manager, but your PostgreSQL
# database name (POSTGRES_DB) can stay as granny_flat if that DB
# already exists locally.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

POSTGRES_DB=granny_flat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
